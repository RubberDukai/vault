{
  "title": "N5 verbs — sixty things people do",
  "description": "Dictionary form on the front; the polite ます form in the note where it is not obvious. Every one of these is on the N5 list and most of them come up in a normal day.",
  "order": 10,
  "cards": [
    { "front": "する", "reading": "suru", "back": "to do", "note": "します shimasu. Irregular — the most useful verb in the language: 勉強する benkyō suru, to study" },
    { "front": "ある", "reading": "aru", "back": "to exist, to have (things)", "note": "あります arimasu. Negative ない nai" },
    { "front": "いる", "reading": "iru", "back": "to exist, to be there (people, animals)", "note": "います imasu" },
    { "front": "言う", "reading": "iu", "back": "to say", "note": "言います iimasu" },
    { "front": "話す", "reading": "hanasu", "back": "to speak, to talk", "note": "話します hanashimasu" },
    { "front": "聞く", "reading": "kiku", "back": "to hear, to listen, to ask", "note": "聞きます kikimasu" },
    { "front": "読む", "reading": "yomu", "back": "to read", "note": "読みます yomimasu" },
    { "front": "書く", "reading": "kaku", "back": "to write", "note": "書きます kakimasu" },
    { "front": "買う", "reading": "kau", "back": "to buy", "note": "買います kaimasu" },
    { "front": "売る", "reading": "uru", "back": "to sell", "note": "売ります urimasu" },
    { "front": "使う", "reading": "tsukau", "back": "to use", "note": "使います tsukaimasu" },
    { "front": "作る", "reading": "tsukuru", "back": "to make", "note": "作ります tsukurimasu" },
    { "front": "働く", "reading": "hataraku", "back": "to work", "note": "働きます hatarakimasu" },
    { "front": "休む", "reading": "yasumu", "back": "to rest, to take a day off", "note": "休みます yasumimasu" },
    { "front": "寝る", "reading": "neru", "back": "to sleep, to go to bed", "note": "寝ます nemasu" },
    { "front": "起きる", "reading": "okiru", "back": "to get up, to wake", "note": "起きます okimasu" },
    { "front": "立つ", "reading": "tatsu", "back": "to stand", "note": "立ちます tachimasu" },
    { "front": "座る", "reading": "suwaru", "back": "to sit", "note": "座ります suwarimasu" },
    { "front": "歩く", "reading": "aruku", "back": "to walk", "note": "歩きます arukimasu" },
    { "front": "走る", "reading": "hashiru", "back": "to run", "note": "走ります hashirimasu" },
    { "front": "泳ぐ", "reading": "oyogu", "back": "to swim", "note": "泳ぎます oyogimasu" },
    { "front": "帰る", "reading": "kaeru", "back": "to go home, to return", "note": "帰ります kaerimasu" },
    { "front": "出る", "reading": "deru", "back": "to go out, to leave", "note": "出ます demasu" },
    { "front": "入る", "reading": "hairu", "back": "to enter", "note": "入ります hairimasu" },
    { "front": "待つ", "reading": "matsu", "back": "to wait", "note": "待ちます machimasu. 待ってください matte kudasai — please wait" },
    { "front": "持つ", "reading": "motsu", "back": "to hold, to carry, to have", "note": "持ちます mochimasu" },
    { "front": "取る", "reading": "toru", "back": "to take", "note": "取ります torimasu" },
    { "front": "置く", "reading": "oku", "back": "to put, to place", "note": "置きます okimasu" },
    { "front": "開ける", "reading": "akeru", "back": "to open (something)", "note": "開けます akemasu" },
    { "front": "閉める", "reading": "shimeru", "back": "to close (something)", "note": "閉めます shimemasu" },
    { "front": "洗う", "reading": "arau", "back": "to wash", "note": "洗います araimasu" },
    { "front": "切る", "reading": "kiru", "back": "to cut", "note": "切ります kirimasu" },
    { "front": "押す", "reading": "osu", "back": "to push, to press", "note": "押します oshimasu — on doors and buttons" },
    { "front": "引く", "reading": "hiku", "back": "to pull", "note": "引きます hikimasu" },
    { "front": "教える", "reading": "oshieru", "back": "to teach, to tell", "note": "教えます oshiemasu. 教えてください — please tell me" },
