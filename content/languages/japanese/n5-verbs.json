    { "front": "生まれる", "reading": "umareru", "back": "to be born", "note": "生まれます umaremasu" },
    { "front": "借りる", "reading": "kariru", "back": "to borrow", "note": "借ります karimasu" },
    { "front": "貸す", "reading": "kasu", "back": "to lend", "note": "貸します kashimasu" },
    { "front": "返す", "reading": "kaesu", "back": "to give back", "note": "返します kaeshimasu" },
    { "front": "着る", "reading": "kiru", "back": "to wear, to put on (upper body)", "note": "着ます kimasu. Same sound as 切る kiru, to cut" },
    { "front": "脱ぐ", "reading": "nugu", "back": "to take off (clothes, shoes)", "note": "脱ぎます nugimasu" },
    { "front": "乗る", "reading": "noru", "back": "to ride, to get on", "note": "乗ります norimasu. 電車に乗る — take the train" },
    { "front": "降りる", "reading": "oriru", "back": "to get off, to come down", "note": "降ります orimasu" },
    { "front": "止まる", "reading": "tomaru", "back": "to stop (itself)", "note": "止まります tomarimasu" },
    { "front": "曲がる", "reading": "magaru", "back": "to turn (a corner)", "note": "曲がります magarimasu. 右に曲がる — turn right" },
    { "front": "渡る", "reading": "wataru", "back": "to cross", "note": "渡ります watarimasu. 橋を渡る — cross the bridge" },
    { "front": "登る", "reading": "noboru", "back": "to climb", "note": "登ります noborimasu" },
    { "front": "消す", "reading": "kesu", "back": "to turn off, to put out, to erase", "note": "消します keshimasu. 火を消す — put out the fire" },
    { "front": "つける", "reading": "tsukeru", "back": "to turn on, to light", "note": "つけます tsukemasu" },
    { "front": "出す", "reading": "dasu", "back": "to take out, to send, to hand in", "note": "出します dashimasu" },
    { "front": "直す", "reading": "naosu", "back": "to fix, to repair", "note": "直します naoshimasu" },
    { "front": "手伝う", "reading": "tetsudau", "back": "to help (with a task)", "note": "手伝います tetsudaimasu. 手伝ってください — please help me" },
    { "front": "疲れる", "reading": "tsukareru", "back": "to get tired", "note": "疲れました tsukaremashita — I'm tired" },
    { "front": "困る", "reading": "komaru", "back": "to be in trouble, to be stuck", "note": "困ります komarimasu. 困っています — I'm in a fix" },
    { "front": "頑張る", "reading": "ganbaru", "back": "to do one's best, to hang in there", "note": "頑張って ganbatte — you can do it" }
  ]
