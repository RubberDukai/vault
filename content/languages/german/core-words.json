{
  "title": "Core words",
  "description": "The pronouns, the question words, the most common verbs and the small words that hold everything together. Nouns come with their gender (der / die / das) — learn them as one word.",
  "order": 2,
  "cards": [
    { "front": "ich", "reading": "ich", "back": "I" },
    { "front": "du", "reading": "doo", "back": "you (one person, familiar)" },
    { "front": "er / sie / es", "reading": "air / zee / es", "back": "he / she / it" },
    { "front": "wir", "reading": "veer", "back": "we" },
    { "front": "ihr", "reading": "eer", "back": "you (several, familiar)" },
    { "front": "sie / Sie", "reading": "zee", "back": "they / you (polite)", "note": "capital S for the polite you; same verb form" },
    { "front": "was", "reading": "vas", "back": "what" },
    { "front": "wer", "reading": "vair", "back": "who" },
    { "front": "wo", "reading": "vo", "back": "where" },
    { "front": "wohin", "reading": "vo-HIN", "back": "where to" },
    { "front": "wann", "reading": "van", "back": "when" },
    { "front": "warum", "reading": "va-ROOM", "back": "why" },
    { "front": "wie", "reading": "vee", "back": "how", "note": "wie viel — how much; wie viele — how many" },
    { "front": "welcher / welche / welches", "reading": "VEL-cher", "back": "which" },
    { "front": "sein", "reading": "zine", "back": "to be", "note": "ich bin, du bist, er ist, wir sind, ihr seid, sie sind" },
