    { "front": "können", "reading": "KÖN-en", "back": "can, to be able", "note": "ich kann, du kannst, er kann, wir können" },
    { "front": "müssen", "reading": "MÜSS-en", "back": "must, to have to", "note": "ich muss, du musst, er muss" },
    { "front": "wollen", "reading": "VOL-en", "back": "to want to", "note": "ich will, du willst, er will" },
    { "front": "möchten", "reading": "MÖCH-ten", "back": "would like", "note": "ich möchte — the polite way to ask for anything" },
    { "front": "dürfen", "reading": "DÜR-fen", "back": "may, to be allowed", "note": "ich darf, du darfst, er darf" },
