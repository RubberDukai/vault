    { "front": "machen", "reading": "MAKH-en", "back": "to do, to make" },
    { "front": "gehen", "reading": "GAY-en", "back": "to go (on foot)" },
    { "front": "kommen", "reading": "KOM-en", "back": "to come" },
    { "front": "fahren", "reading": "FAH-ren", "back": "to go (by vehicle), to drive", "note": "du fährst, er fährt" },
    { "front": "essen", "reading": "ESS-en", "back": "to eat", "note": "du isst, er isst" },
    { "front": "trinken", "reading": "TRIN-ken", "back": "to drink" },
    { "front": "sehen", "reading": "ZAY-en", "back": "to see", "note": "du siehst, er sieht" },
    { "front": "sprechen", "reading": "SHPRECH-en", "back": "to speak", "note": "du sprichst, er spricht" },
    { "front": "sagen", "reading": "ZAH-gen", "back": "to say" },
    { "front": "geben", "reading": "GAY-ben", "back": "to give", "note": "er gibt; es gibt — there is / there are" },
    { "front": "nehmen", "reading": "NAY-men", "back": "to take", "note": "du nimmst, er nimmt" },
    { "front": "wissen", "reading": "VISS-en", "back": "to know (a fact)", "note": "ich weiß, du weißt, er weiß" },
    { "front": "kennen", "reading": "KEN-en", "back": "to know (a person, a place)" },
    { "front": "brauchen", "reading": "BROW-khen", "back": "to need" },
    { "front": "und", "reading": "oont", "back": "and" },
    { "front": "oder", "reading": "OH-der", "back": "or" },
    { "front": "aber", "reading": "AH-ber", "back": "but" },
    { "front": "nicht", "reading": "nicht", "back": "not" },
