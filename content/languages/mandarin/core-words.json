{
  "title": "Core words",
  "description": "Forty high-frequency words. Grammar is minimal — no tenses, no plurals, no conjugation — so vocabulary plus word order gets you talking fast. Mind the tones.",
  "order": 2,
  "cards": [
    { "front": "我", "reading": "wǒ", "back": "I, me" },
    { "front": "你", "reading": "nǐ", "back": "you" },
    { "front": "他 / 她", "reading": "tā", "back": "he / she", "note": "same sound, different characters" },
    { "front": "我们", "reading": "wǒmen", "back": "we, us", "note": "们 makes any person-word plural" },
    { "front": "这", "reading": "zhè", "back": "this" },
    { "front": "那", "reading": "nà", "back": "that" },
    { "front": "什么", "reading": "shénme", "back": "what" },
    { "front": "哪里", "reading": "nǎlǐ", "back": "where" },
    { "front": "谁", "reading": "shéi", "back": "who" },
    { "front": "为什么", "reading": "wèishénme", "back": "why" },
    { "front": "好", "reading": "hǎo", "back": "good, well, OK" },
    { "front": "不", "reading": "bù", "back": "not, no", "note": "goes before the verb: 不好 bù hǎo — not good" },
    { "front": "有", "reading": "yǒu", "back": "to have, there is", "note": "negated with 没 méi, not 不: 没有 méiyǒu" },
    { "front": "是", "reading": "shì", "back": "to be (is, am, are)" },
    { "front": "要", "reading": "yào", "back": "to want, to need, will", "note": "我要水。 I want water." },
    { "front": "去", "reading": "qù", "back": "to go" },
    { "front": "来", "reading": "lái", "back": "to come" },
    { "front": "吃", "reading": "chī", "back": "to eat", "note": "吃饭 chīfàn — to eat (a meal)" },
    { "front": "喝", "reading": "hē", "back": "to drink" },
    { "front": "看", "reading": "kàn", "back": "to look, to see, to read" },
    { "front": "说", "reading": "shuō", "back": "to speak, to say" },
    { "front": "做", "reading": "zuò", "back": "to do, to make" },
    { "front": "给", "reading": "gěi", "back": "to give; for", "note": "给我 gěi wǒ — give me" },
    { "front": "会", "reading": "huì", "back": "can (know how to); will", "note": "我会说英语。 I can speak English." },
    { "front": "能", "reading": "néng", "back": "can (be able to)" },
    { "front": "人", "reading": "rén", "back": "person" },
    { "front": "家", "reading": "jiā", "back": "home, family" },
    { "front": "水", "reading": "shuǐ", "back": "water" },
    { "front": "饭", "reading": "fàn", "back": "rice, a meal" },
    { "front": "钱", "reading": "qián", "back": "money" },
    { "front": "天", "reading": "tiān", "back": "day, sky", "note": "今天 jīntiān today · 明天 míngtiān tomorrow · 昨天 zuótiān yesterday" },
    { "front": "大", "reading": "dà", "back": "big" },
    { "front": "小", "reading": "xiǎo", "back": "small" },
    { "front": "多", "reading": "duō", "back": "many, much" },
    { "front": "少", "reading": "shǎo", "back": "few, little" },
    { "front": "很", "reading": "hěn", "back": "very", "note": "sits between subject and adjective: 我很好。 I'm (very) well." },
    { "front": "也", "reading": "yě", "back": "also" },
    { "front": "都", "reading": "dōu", "back": "all, both" },
    { "front": "的", "reading": "de", "back": "possessive / 's", "note": "我的家 wǒ de jiā — my home" },
    { "front": "吗", "reading": "ma", "back": "question marker", "note": "end of sentence: 你好吗？ Are you well?" }
  ]
}
